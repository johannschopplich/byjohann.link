{
  "name": "byjohann-link",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "pnpm run uno:clean && nuxt dev",
    "build": "pnpm run uno:build && nuxt build",
    "generate": "pnpm run uno:build && nuxt generate",
    "preview": "nuxt preview",
    "uno:clean": "echo \"/**/\" > app/assets/uno.css",
    "uno:build": "unocss --minify",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"**/*.{css,html,json,md,mjs,ts,vue,yml}\" --write",
    "format:check": "prettier \"**/*.{css,html,json,md,mjs,ts,vue,yml}\" --check",
    "test:types": "vue-tsc -b --noEmit",
    "prepare": "pnpm run uno:clean && nuxt prepare"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@iconify-json/carbon": "^1.2.20",
    "@iconify-json/simple-icons": "^1.2.81",
    "@nuxtjs/color-mode": "^4.0.0",
    "@sindresorhus/slugify": "^3.0.0",
    "@types/node": "^24.12.2",
    "@unocss/eslint-config": "^66.6.8",
    "@unocss/nuxt": "^66.6.8",
    "@vueuse/nuxt": "^14.3.0",
    "culori": "^4.0.2",
    "eslint": "^10.3.0",
    "nuxt": "^4.4.4",
    "nuxt-kirby": "^3.0.3",
    "postcss-nesting": "^14.0.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "vue-demi"
    ]
  }
}
