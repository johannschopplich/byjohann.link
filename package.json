{
  "name": "byjohann-link",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm run uno:clean && nuxt dev",
    "build": "pnpm run uno:build && nuxt build",
    "generate": "pnpm run uno:build && nuxt generate",
    "preview": "nuxt preview",
    "uno:clean": "echo \"/**/\" > app/assets/uno.css",
    "uno:build": "unocss --minify",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"**/*.{css,html,json,md,mjs,ts,vue,yml}\" --write",
    "format:check": "prettier \"**/*.{css,html,json,md,mjs,ts,vue,yml}\" --check",
    "test:types": "vue-tsc -b --noEmit",
    "prepare": "pnpm run uno:clean && nuxt prepare"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@iconify-json/carbon": "^1.2.23",
    "@iconify-json/simple-icons": "^1.2.88",
    "@nuxtjs/color-mode": "^4.0.1",
    "@sindresorhus/slugify": "^3.0.0",
    "@types/node": "^26.1.0",
    "@unocss/cli": "^66.7.5",
    "@unocss/eslint-config": "^66.7.4",
    "@unocss/nuxt": "^66.7.4",
    "@unocss/preset-wind4": "^66.7.5",
    "@vueuse/nuxt": "^14.3.0",
    "culori": "^4.0.2",
    "eslint": "^10.6.0",
    "kirby-types": "^1.5.0",
    "nuxt": "^4.4.8",
    "nuxt-kirby": "^3.0.3",
    "postcss-nesting": "^14.0.0",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "ufo": "^1.6.4",
    "unocss": "^66.7.5",
    "vue-tsc": "^3.3.6"
  }
}
